    <key>PATH</key>
    <string>__SAFE_PATH__</string>
    <key>PYTHON_BIN</key>
    <string>__PYTHON_BIN__</string>
  </dict>
  <key>RunAtLoad</key>
  __OVERVIEW_RUN_AT_LOAD__
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardErrorPath</key>
  <string>__STATE_ROOT__/log/overview-refresh.err.log</string>
  <key>StandardOutPath</key>
  <string>__STATE_ROOT__/log/overview-refresh.log</string>
