    <string>__STATE_ROOT__</string>
    <key>CODEX_BIN</key>
    <string>__CODEX_BIN__</string>
    <key>CODEX_HOME</key>
    <string>__CODEX_HOME__</string>
    <key>CLAUDE_BIN</key>
    <string>__CLAUDE_BIN__</string>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>__CLAUDE_HOME__</string>
    <key>CLAUDE_HOME</key>
    <string>__CLAUDE_HOME__</string>
    <key>OPENRELIX_ACTIVITY_SOURCE</key>
    <string>__ACTIVITY_SOURCE__</string>
    <key>OPENRELIX_ACTIVITY_HOST</key>
    <string>__ACTIVITY_HOST__</string>
    <key>OPENRELIX_MODEL_CLI</key>
    <string>__MODEL_CLI__</string>
    <key>OPENRELIX_CLAUDE_MODEL</key>
    <string>__CLAUDE_MODEL__</string>
