__pycache__/
*.pyc

# Local runtime state and generated reports stay outside version control.
raw/
consolidated/
registry/
reviews/
reports/
runtime/
log/

# Sanitized fixtures intentionally mirror state-root directory names.
!tests/fixtures/
!tests/fixtures/sample-state/
!tests/fixtures/sample-state/raw/
!tests/fixtures/sample-state/raw/**
!tests/fixtures/sample-state/consolidated/
!tests/fixtures/sample-state/consolidated/**
!tests/fixtures/sample-state/registry/
!tests/fixtures/sample-state/registry/**

# Local scratch artifacts.
.tmp/
dist/
test-results/
.DS_Store
.playwright-mcp/
*.png
*.jpg
*.jpeg
*.webp
!macos/OpenRelixClient/AppIcon.png
!docs/openrelix-icon.png
!docs/assets/
!docs/assets/getting-started-*.png

# Keep the sanitized product showcase screenshots publishable.
!docs/product-showcase-assets/
docs/product-showcase-assets/*.png
!docs/product-showcase-assets/real-panel-*.png

# Local-only private skills that should not be published.
.agents/skills/personal-asset-librarian/
plugins/ai-personal-assets/skills/personal-asset-librarian
plugins/codex-personal-assets/skills/personal-asset-librarian
plugins/openrelix/skills/personal-asset-librarian
