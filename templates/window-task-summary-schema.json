{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_cluster_algorithm_version",
    "date_range",
    "source_summary_dates",
    "project_task_clusters"
  ],
  "properties": {
    "schema_version": { "type": "integer" },
    "task_cluster_algorithm_version": { "type": "integer" },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "source_summary_dates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "project_task_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id",
          "project_label",
          "cwd",
          "task_title",
          "task_summary",
          "source_window_ids",
          "status_tags",
          "confidence"
        ],
        "properties": {
          "cluster_id": { "type": "string", "minLength": 1 },
          "project_label": { "type": "string" },
          "cwd": { "type": "string" },
          "task_title": { "type": "string", "minLength": 1 },
          "task_summary": { "type": "string" },
          "source_window_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    }
  }
}
